        # Hide the stock visuals + colliders under /so101/gripper. The
        # gripper body itself stays active — it's the wrist-roll
        # follower link, used as the mount frame.
        over "gripper"
        {
            over "visuals" (active = false) {}
            over "collisions" (active = false) {}

            # Cylinder stem at the wrist's local -Z (this is the outward
            # direction in the SO-101 URDF convention — gripper-local +Z
            # points back into the arm). Translate is half the height so
            # the cylinder centre is at z=-height/2 and its near face
            # (joined to the wrist) sits at z=0.
            def Cylinder "stem" (
                prepend apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                double radius = 0.012
                double height = 0.025
                uniform token axis = "Z"
                double3 xformOp:translate = (0, 0, -0.0125)
                uniform token[] xformOpOrder = ["xformOp:translate"]
                color3f[] primvars:displayColor = [(0.92, 0.38, 0.1)]
            }
        }
    }
}
