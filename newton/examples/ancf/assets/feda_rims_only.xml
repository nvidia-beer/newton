    <!-- Kinematic steering: the front kingpin hinges are position-driven directly.
         The pitman/idler/steering_link/tierod chain is gone, so there is no soft
         equality path between the steer command and the upright.  Stiffening that
         chain (solref 0.02 -> 0.002) was measured to make no difference; removing
         the DOF from the dynamics is what matters. -->
    <position name="steer_fl_act" joint="upright_fl_steer" kp="200000" kv="20000" ctrlrange="-0.47947 0.47947"/>
    <position name="steer_fr_act" joint="upright_fr_steer" kp="200000" kv="20000" ctrlrange="-0.47947 0.47947"/>
    
    <velocity name="axle_fl_act" joint="axle_fl" kv="800" />
    <velocity name="axle_fr_act" joint="axle_fr" kv="800" />
    <velocity name="axle_rl_act" joint="axle_rl" kv="800" />
    <velocity name="axle_rr_act" joint="axle_rr" kv="800" />
  </actuator>

</mujoco>