          </body>
        </body>
      </body>

      <body name="lca_rr" pos="-1.7932  0.22348 -0.0995">
        <joint name="lca_rr_hinge" type="hinge" axis="-0.9980 0 -0.0628"/>
        <inertial mass="31.55" pos="0.0500  0.1949 -0.0133"
                  diaginertia="0.4 0.4 0.8938"/>
        <geom type="capsule"
              fromto=" 0.31000 -0.00102  0.01950   0.15008  0.58371 -0.03954"
              size="0.022" rgba="0.85 0.45 0.10 1"/>
        <geom type="capsule"
              fromto="-0.31000  0.00103 -0.01950   0.15008  0.58371 -0.03954"
              size="0.022" rgba="0.85 0.45 0.10 1"/>

        <site name="spring_a_rr" pos="0.04820  0.42805 -0.0195"/>
      </body>

      <!-- ══════════════════════════════════════════════════════════════════
           PITMAN-ARM STEERING
           REV axis = Z (vertical kingpin).  Pitman arm on left (−Y),
           idler arm on right (+Y).
           REV chassis: [1.160, −0.379095, 0]
           UNIV chassis: [1.410, −0.379095, 0]  (arm length = 0.250 m along X)
      ══════════════════════════════════════════════════════════════════ -->

      <body name="pitman_arm" pos="1.160 -0.379095 0">
        <joint name="steer_motor" type="hinge" axis="0 0 1"
               limited="true" range="-0.47947 0.47947"/>
        <inertial mass="1.605" pos="0.125 0 0"
                  diaginertia="0.00638 0.00756 0.00150"/>
        <geom type="capsule" fromto="0 0 0   0.250 0 0"
              size="0.018" rgba="0.40 0.75 0.40 1"/>

        <!-- steering link: ball joint at UNIV, 0.250 m along arm -->
        <body name="steering_link" pos="0.250 0 0">
          <joint name="steering_link_ball" type="ball"/>
          <inertial mass="3.681" pos="0 0.379095 0.04"
                    diaginertia="0.252 0.00233 0.254"/>
          <!-- bar from FL tierod attach (Y=0) to FR (Y=+0.75819) -->
          <geom type="capsule"
                fromto="0 0 0.04   0 0.758190 0.04"
                size="0.016" rgba="0.40 0.75 0.40 1"/>

          <!-- FL tierod body: ball joint at TIEROD_PA (SL local [0,0,0.04]) -->
          <body name="tierod_fl" pos="0 0 0.04">
            <joint name="tierod_fl_ball" type="ball"/>
            <inertial mass="6.0" pos="0.017 -0.224 -0.020"
                      diaginertia="0.05 0.05 0.5"/>
            <!-- far end → TIEROD_U_FL: offset [0.034,−0.447,−0.040] -->
            <geom type="capsule" fromto="0 0 0   0.034 -0.447 -0.040"
                  size="0.012" rgba="0.50 0.80 0.50 1"/>
          </body>

          <!-- FR tierod body (Y-mirror, at right end of steering bar) -->
          <body name="tierod_fr" pos="0 0.758190 0.04">
            <joint name="tierod_fr_ball" type="ball"/>
            <inertial mass="6.0" pos="0.017  0.224 -0.020"
                      diaginertia="0.05 0.05 0.5"/>
            <geom type="capsule" fromto="0 0 0   0.034  0.447 -0.040"
                  size="0.012" rgba="0.50 0.80 0.50 1"/>
          </body>
        </body>
      </body><!-- pitman_arm -->

      <!-- Rear tierod bodies: ball joint at TIEROD_C, far end at TIEROD_U -->
      <!-- RL: TIEROD_C chassis=(−1.410,−0.379095,0.04), U=(−1.444,−0.82618,0) -->
      <body name="tierod_rl" pos="-1.410 -0.379095 0.04">
        <joint name="tierod_rl_ball" type="ball"/>
        <inertial mass="6.0" pos="-0.017 -0.224 -0.020"
                  diaginertia="0.05 0.05 0.5"/>
        <geom type="capsule" fromto="0 0 0   -0.034 -0.447 -0.040"
              size="0.012" rgba="0.50 0.80 0.50 1"/>
      </body>
      <body name="tierod_rr" pos="-1.410  0.379095 0.04">
        <joint name="tierod_rr_ball" type="ball"/>
        <inertial mass="6.0" pos="-0.017  0.224 -0.020"
                  diaginertia="0.05 0.05 0.5"/>
        <geom type="capsule" fromto="0 0 0   -0.034  0.447 -0.040"
              size="0.012" rgba="0.50 0.80 0.50 1"/>
      </body>

      <!-- Idler arm: passive Z-hinge on right side, mirrors pitman arm -->
      <body name="idler_arm" pos="1.160  0.379095 0">
        <joint name="idler_hinge" type="hinge" axis="0 0 1"/>
        <inertial mass="1.5" pos="0.125 0 0"
                  diaginertia="0.003 0.008 0.008"/>
        <geom type="capsule" fromto="0 0 0   0.250 0 0"
              size="0.018" rgba="0.40 0.75 0.40 1"/>
      </body>

    </body><!-- chassis -->
  </worldbody>

  <!-- ── Equality constraints ── -->
  <equality>
    <!-- Wishbone loop closures: LCA_U anchor in lca body frame -->
    <connect name="lca_fl_close" body1="lca_fl"  body2="upright_fl"
             anchor="0.15008 -0.58371 -0.03954"/>
    <connect name="lca_fr_close" body1="lca_fr"  body2="upright_fr"
             anchor="0.15008  0.58371 -0.03954"/>
    <connect name="lca_rl_close" body1="lca_rl"  body2="upright_rl"
             anchor="0.15008 -0.58371 -0.03954"/>
    <connect name="lca_rr_close" body1="lca_rr"  body2="upright_rr"
             anchor="0.15008  0.58371 -0.03954"/>

    <!-- Idler arm tip coincides with right end of steering link at q=0 -->
    <connect name="idler_close" body1="idler_arm" body2="steering_link"
             anchor="0.250 0 0"/>

    <!-- Front tierods: far end of tierod body → TIEROD_U on upright -->
    <connect name="tierod_fl_end" body1="tierod_fl" body2="upright_fl"
             anchor="0.034 -0.447 -0.040"/>
    <connect name="tierod_fr_end" body1="tierod_fr" body2="upright_fr"
             anchor="0.034  0.447 -0.040"/>

    <!-- Rear tierods -->
    <connect name="tierod_rl_end" body1="tierod_rl" body2="upright_rl"
             anchor="-0.034 -0.447 -0.040"/>
    <connect name="tierod_rr_end" body1="tierod_rr" body2="upright_rr"
             anchor="-0.034  0.447 -0.040"/>
  </equality>

  <!-- ── TSDA spring-damper tendons ── -->
  <!-- TSDA: k=76000 N/m, c=38097 N·s/m.
       springlength=0.792: at q=0 (d=0.602 m) spring force=14440 N ≈ per-corner weight 13919 N
       → near-static equilibrium at startup, avoids frame-0 constraint spike. -->
  <tendon>
    <spatial name="tsda_fl" stiffness="76000" damping="38097" springlength="0.792">
      <site site="spring_c_fl"/>
      <site site="spring_a_fl"/>
    </spatial>
    <spatial name="tsda_fr" stiffness="76000" damping="38097" springlength="0.792">
      <site site="spring_c_fr"/>
      <site site="spring_a_fr"/>
    </spatial>
    <spatial name="tsda_rl" stiffness="76000" damping="38097" springlength="0.792">
      <site site="spring_c_rl"/>
      <site site="spring_a_rl"/>
    </spatial>
    <spatial name="tsda_rr" stiffness="76000" damping="38097" springlength="0.792">
      <site site="spring_c_rr"/>
      <site site="spring_a_rr"/>
    </spatial>
  </tendon>

  <!-- ── Actuators ── -->
  <actuator>
    <!-- Pitman arm steering motor: position-controlled, ±27.5° -->
    <position name="steer_motor_act" joint="steer_motor" kp="8000" kv="500"
              ctrlrange="-0.47947 0.47947"/>
    <!-- 4WD axles: velocity-controlled -->
    <velocity name="axle_fl_act" joint="axle_fl" kv="800"/>
    <velocity name="axle_fr_act" joint="axle_fr" kv="800"/>
    <velocity name="axle_rl_act" joint="axle_rl" kv="800"/>
    <velocity name="axle_rr_act" joint="axle_rr" kv="800"/>
  </actuator>

</mujoco>
