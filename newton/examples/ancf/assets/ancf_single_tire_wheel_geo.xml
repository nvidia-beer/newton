<mujoco model="ancf_single_tire_wheel_geo">
  <!--
    Wheel-geometry rig for ancf_single_tire_mujoco: 5 kg spindle, R=0.15 m hub.
    Same carrier/slide_z + spindle/spin_y topology as ancf_single_tire.xml but
    with 5 kg spindle mass and slide_z damping=100 for the parabolic wheel_geo config.
    Used with ancf_single_tire_mujoco_wheel_geo.json for FPS benchmarking.
  -->
  <compiler angle="radian"/>
  <option gravity="0 0 -9.81"/>
  <default>
    <joint damping="0.5"/>
  </default>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="ground" type="plane" size="10 10 0.1" rgba="0.65 0.65 0.65 1"/>

    <body name="carrier" pos="0 0 0">
      <!-- slide_z damping=100 N·s/m: limits terminal velocity to M·g/D=0.49 m/s -->
      <joint name="slide_z" type="slide" axis="0 0 1" damping="100"/>
      <inertial mass="1e-3" pos="0 0 0" diaginertia="1e-6 1e-6 1e-6"/>

      <body name="spindle" pos="0 0 0">
        <joint name="spin_y" type="hinge" axis="0 1 0"/>
        <!-- 5 kg spindle: solid cylinder R=0.05 m, L=0.12 m -->
        <inertial mass="5.0" pos="0 0 0" diaginertia="0.00913 0.00625 0.00913"/>
        <geom name="hub_vis" type="cylinder" size="0.05 0.06"
              euler="1.5708 0 0" rgba="0.35 0.35 0.75 0.80"
              contype="0" conaffinity="0"/>
        <geom name="axle_vis" type="capsule" size="0.012 0.065"
              euler="1.5708 0 0" rgba="1.0 0.75 0.0 1.0"
              contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="spin_motor" joint="spin_y" ctrllimited="false"/>
  </actuator>
</mujoco>
