# Newton with UV - x86_64 Build
# Simple, fast, reproducible builds
FROM ghcr.io/astral-sh/uv:python3.11-bookworm

WORKDIR /workspace/newton

# Install git, build tools, and OpenGL libraries for viewer
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    python3.11-dev \
    libgl1-mesa-glx \
    libglu1-mesa \
    libxrender1 \
    libxext6 \
    libx11-6 \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files only (for layer caching)
COPY pyproject.toml uv.lock ./

# Copy README files needed for metadata generation (referenced in pyproject.toml)
COPY README.md README.md
COPY newton/_version.py newton/_version.py

# Install dependencies (without project source)
RUN uv sync --frozen --no-install-workspace --extra dev

# Copy source code
COPY . ./

# Install workspace packages
RUN uv sync --frozen --extra dev

ENV PATH="/workspace/newton/.venv/bin:$PATH"

CMD ["/bin/bash"]
