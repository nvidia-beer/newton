            {"name": "Pitch",       "default": -1.5, "lower": -1.5, "upper": 1.5, "stiffness": 3.0e5, "damping": 8.0e3, "effort_limit": 3.0e5},
            {"name": "Elbow",       "default":  1.5, "lower": -1.5, "upper": 1.5, "stiffness": 2.5e5, "damping": 7.0e3, "effort_limit": 3.0e5},
            {"name": "Wrist_Pitch", "default": -1.5, "lower": -1.5, "upper": 1.5, "stiffness": 1.2e5, "damping": 5.0e3, "effort_limit": 3.0e5},
            {"name": "Wrist_Roll",  "default":  0.0, "lower": -1.5, "upper": 1.5, "stiffness": 7.0e4, "damping": 5.0e3, "effort_limit": 3.0e5}
        ],
        "rigid-objects": [
