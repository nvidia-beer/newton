{
    "description": "SO-101 IK + chambered soft gripper as a KINEMATICS-ONLY proxy for rigid capsule colliders on the wrist cylinder. The FEM lives at world origin with hub particles anchored (inv_mass=0), runs with zero gravity and no contacts. Each substep its deformed finger keypoints are transformed by the cylinder-tip pose and used to drive kinematic capsule bodies in the MuJoCo scene — capsules collide with rigid_objects; the FEM never applies forces.",
    "args": {
        "viewer": "gl",
        "num-frames": 14400,
        "robot-asset": "/workspace/newton/newton/examples/inflatable/assets/so101/SO-ARM101-10x-stem.usd",
        "asset": "/workspace/newton/newton/examples/inflatable/assets/gripper/gripper_4f.usda",
        "substeps": 2,
        "gravity": 9.81,
        "mass": 1.5,
        "k_mu": 30000.0,
        "k_lambda": 30000.0,
        "k_damp": 1.0,
        "max-pressure": 5,
        "torque-stiffness": 100.0,
        "torque-damping": 1.0,
        "spring-ke": 50000.0,
        "spring-kd": 1.0,
        "pressure-rate": 0.01,
        "contact-iterations": 48,
        "ground-ke": 6000000.0,
        "ground-friction": 0.85,
        "chamber-stiffness-scale": 2.0,
        "structural-stiffness-scale": 40.0,
