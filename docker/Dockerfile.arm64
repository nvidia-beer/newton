# Newton with UV - ARM64 Build (CUDA Optimized)
# Uses NVIDIA CUDA 13 base image to match warp-lang v1.12.0+cu13
FROM nvidia/cuda:13.0.0-devel-ubuntu22.04 AS base

WORKDIR /workspace/newton

# Install Python 3.11 and system dependencies.
# Ubuntu 22.04's default `python3` is 3.10, which is what uv picks for the venv
# on this base image. We install BOTH sets of dev headers so native wheels
# (e.g. fast-simplification) can compile against whichever interpreter uv
# chooses.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3.10-dev \
    python3-pip \
    git \
    curl \
    ca-certificates \
    build-essential \
    # OpenGL (NVIDIA GPU-accelerated via GLVND - vendor neutral dispatch)
    libglvnd-dev \
    libgl1 \
    libglx-dev \
    libegl-dev \
    libegl1 \
    libgles-dev \
    # X11 packages for windowing
    libxrender1 \
    libxext6 \
    libx11-6 \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    && rm -rf /var/lib/apt/lists/*

# --- UV and project deps ---
# Copy UV binary from official UV image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY --from=ghcr.io/astral-sh/uv:latest /uvx /usr/local/bin/uvx

# Copy dependency files only (for layer caching)
COPY pyproject.toml uv.lock ./

# Copy files referenced by hatchling during metadata resolution
COPY README.md README.md
COPY newton/_version.py newton/_version.py
COPY LICENSE.md LICENSE.md
COPY newton/licenses newton/licenses

# Install Python deps.
# Not using --frozen to allow platform-specific dependency resolution
# (on ARM64, warp-lang is installed from GitHub releases).
RUN uv sync --no-install-workspace --extra dev

# Copy source code
COPY . ./

# Install workspace packages
RUN uv sync --extra dev

ENV PATH="/workspace/newton/.venv/bin:$PATH"

CMD ["/bin/bash"]
