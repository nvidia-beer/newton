# Newton with UV - ARM64 Build (CUDA Optimized)
# Uses NVIDIA CUDA 13 base image to match warp-lang v1.12.0+cu13
FROM nvidia/cuda:13.0.0-devel-ubuntu22.04 AS base

WORKDIR /workspace/newton

# Install Python 3.11 and system dependencies.
# Ubuntu 22.04's default `python3` is 3.10, which is what uv picks for the venv
# on this base image. We install BOTH sets of dev headers so native wheels
# (e.g. fast-simplification) can compile against whichever interpreter uv
# chooses.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3.10-dev \
    python3-pip \
    git \
    curl \
    ca-certificates \
    build-essential \
    # OpenGL (NVIDIA GPU-accelerated via GLVND - vendor neutral dispatch)
    libglvnd-dev \
    libgl1 \
    libglx-dev \
    libegl-dev \
    libegl1 \
    libgles-dev \
    # X11 packages for windowing
    libxrender1 \
    libxext6 \
    libx11-6 \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    && rm -rf /var/lib/apt/lists/*

# --- UV and project deps ---
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY --from=ghcr.io/astral-sh/uv:latest /uvx /usr/local/bin/uvx

# Copy dependency files only (for layer caching)
COPY pyproject.toml uv.lock ./

# Copy files referenced by hatchling during metadata resolution
COPY README.md README.md
COPY newton/_version.py newton/_version.py
COPY LICENSE.md LICENSE.md
COPY newton/licenses newton/licenses

# Submodule providing the editable `mujoco-warp` path source declared in
# pyproject.toml under [tool.uv.sources]. Must exist before `uv sync` or
# dependency resolution fails with "Distribution not found".
COPY third_party/mujoco_warp third_party/mujoco_warp

# Install Python deps from the lockfile exactly.
# --frozen avoids re-resolution: mujoco 3.8.x is no longer on PyPI but is pinned
# in uv.lock, and the arm64 warp wheel is already in the lockfile too.
RUN uv sync --frozen --prerelease=allow --no-install-workspace --extra dev

# Copy source code
COPY . ./

# Install workspace packages
RUN uv sync --frozen --prerelease=allow --extra dev

# Install Nsight Systems CLI — placed after uv sync to preserve dep-resolution
# cache. cuda-nsight-systems-13-0 is in the pre-configured CUDA 13 apt repo.
# nvtx Python package: required by wp.ScopedTimer(use_nvtx=True).
# On CUDA 13 libnvToolsExt.so is gone (header-only); nvidia-nvtx-cu12 still
# ships the Python bindings + stubs that nsys can intercept at the API level.
RUN apt-get update && apt-get install -y --no-install-recommends \
    cuda-nsight-systems-13-0 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir nvidia-nvtx-cu12

ENV PATH="/workspace/newton/.venv/bin:$PATH"

CMD ["/bin/bash"]
